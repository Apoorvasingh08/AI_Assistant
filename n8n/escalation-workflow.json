{
  "name": "Support Escalation Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "escalation",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1a1b1c1d-0001-4a4a-8a8a-000000000001",
      "name": "Webhook - Escalation Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "escalation"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-conversation-id",
              "leftValue": "={{$json.body.conversation_id}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1b1c1d-0002-4a4a-8a8a-000000000002",
      "name": "Guard - Has conversation_id",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Deduplicate rapid-fire repeat webhook calls for the same\n// conversation (e.g. a retried request from the app, or the app\n// firing twice due to a race). Uses n8n's built-in static workflow\n// data as a lightweight in-memory cache; the app-side unique DB\n// index is the authoritative guard, this is a defense-in-depth\n// second layer at the automation level.\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.recentlyNotified) staticData.recentlyNotified = {};\n\nconst conversationId = $input.first().json.body.conversation_id;\nconst now = Date.now();\nconst DEDUPE_WINDOW_MS = 5 * 60 * 1000; // 5 minutes\n\nconst lastNotified = staticData.recentlyNotified[conversationId];\nconst isDuplicate = lastNotified && (now - lastNotified) < DEDUPE_WINDOW_MS;\n\nstaticData.recentlyNotified[conversationId] = now;\n\nreturn [{\n  json: {\n    ...$input.first().json.body,\n    isDuplicate\n  }\n}];"
      },
      "id": "1a1b1c1d-0003-4a4a-8a8a-000000000003",
      "name": "Dedupe Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-not-dup",
              "leftValue": "={{$json.isDuplicate}}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1b1c1d-0004-4a4a-8a8a-000000000004",
      "name": "Guard - Not a Duplicate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.discordWebhookUrl || 'https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK_ID/REPLACE_WITH_YOUR_WEBHOOK_TOKEN'}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"content\": \"🚨 **Support escalation**\\n**Conversation:** `\" + $json.conversation_id + \"`\\n**Classification:** \" + $json.classification + \"\\n**Reason:** \" + $json.reason + \"\\n**Customer message:**\\n> \" + $json.customer_message + \"\\n**Escalated at:** \" + $json.escalated_at } }}",
        "options": {}
      },
      "id": "1a1b1c1d-0005-4a4a-8a8a-000000000005",
      "name": "Discord - Notify Support Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"notified\", \"conversation_id\": $json.conversation_id } }}"
      },
      "id": "1a1b1c1d-0006-4a4a-8a8a-000000000006",
      "name": "Respond - Notified",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1360, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"skipped_duplicate\", \"conversation_id\": $json.conversation_id } }}"
      },
      "id": "1a1b1c1d-0007-4a4a-8a8a-000000000007",
      "name": "Respond - Skipped (Duplicate)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1140, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"missing conversation_id\" } }}"
      },
      "id": "1a1b1c1d-0008-4a4a-8a8a-000000000008",
      "name": "Respond - Bad Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 480]
    }
  ],
  "connections": {
    "Webhook - Escalation Trigger": {
      "main": [[{ "node": "Guard - Has conversation_id", "type": "main", "index": 0 }]]
    },
    "Guard - Has conversation_id": {
      "main": [
        [{ "node": "Dedupe Check", "type": "main", "index": 0 }],
